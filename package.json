    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  }
}
